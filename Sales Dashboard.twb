    <worksheet name='Sales KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+ (Sales Data)' name='federated.0lfznhx16vma051abrpg308ufidc' />
          </datasources>
          <datasource-dependencies datasource='federated.0lfznhx16vma051abrpg308ufidc'>
