            <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Ship Mode]' role='dimension' type='nominal' />
            <column caption='Total CY sales' datatype='real' name='[Total CY Qty (copy)_0206987470540804]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(YEAR([Order Date]))} THEN [Sales] END' />
            </column>
            <column caption='Total PY sales' datatype='real' name='[Total PY Qty (copy)_0206987470639109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = {MAX(YEAR([Order Date]))}-1 THEN [Sales] END' />
            </column>
            <column caption='YOY  Sales  indicator ' datatype='string' name='[YOY  Qty indicator (copy)_0206987470880775]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [YOY Qty (copy)_0206987470712838]&gt;0 THEN &quot;▲&quot; ELSE &quot;▼&quot; END' />
            </column>
            <column caption='YOY Sales' datatype='real' name='[YOY Qty (copy)_0206987470712838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Total CY Qty (copy)_0206987470540804])-SUM([Total PY Qty (copy)_0206987470639109]))/SUM([Total PY Qty (copy)_0206987470639109])' />
            </column>
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Country/Region]' derivation='None' name='[none:Country/Region:nk]' pivot='key' type='nominal' />
