            <column-instance column='[YOY  Qty indicator (copy)_0206987470880775]' derivation='User' name='[usr:YOY  Qty indicator (copy)_0206987470880775:nk]' pivot='key' type='nominal' />
            <column-instance column='[YOY Qty (copy)_0206987470712838]' derivation='User' name='[usr:YOY Qty (copy)_0206987470712838:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
